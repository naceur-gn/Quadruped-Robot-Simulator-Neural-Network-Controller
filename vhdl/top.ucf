# Timing constraint for 50 MHz system clock
NET "clk" TNM_NET = "sys_clk_pin";
TIMESPEC TS_sys_clk_pin = PERIOD "sys_clk_pin" 20.000 ns HIGH 50%;

# Clock and Reset pins
NET "clk"         LOC = "V10" | IOSTANDARD = LVCMOS33;
NET "rst"         LOC = "T10" | IOSTANDARD = LVCMOS33 | PULLDOWN;

# UART cable pins (115200 baud, 8-N-1)
# Cable TX -> FPGA uart_rx_pin
# Cable RX <- FPGA uart_tx_pin
NET "uart_rx_pin" LOC = "N17" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "uart_tx_pin" LOC = "N18" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST;

# Diagnostic LEDs
NET "leds<0>"     LOC = "U16" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW; # Heartbeat
NET "leds<1>"     LOC = "V16" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW; # RX active
NET "leds<2>"     LOC = "U15" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW; # NN computing
NET "leds<3>"     LOC = "V15" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW; # TX active
